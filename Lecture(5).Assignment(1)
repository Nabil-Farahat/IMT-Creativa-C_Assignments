#include <stdio.h>



int main ()
{
	int n ;
	printf("Enter number of elements: ");
	scanf("%d",&n);
	int arr[n];
	
	for (int i = 0; i < n; i++)
	{
		printf("enter the %d element: ",i+1);
		scanf("%d",&arr[i]);
	}
	// the bubble sorting method 
	for (int i = 0; i < n -1; i++)
	{
		for (int j = 0; j < n -1 ; j++)
		{
			if (arr[j] > arr[j+1])
			{
				int tmp = arr [j];
			    arr[j] =arr[j+1];
			    arr[j+1]= tmp;
			}
		}
	}
	printf("\nSorted elements: ");
	//printing each element from min to max
    for (int i =0; i < n ; i++)
   {
	   printf("%d\n",arr[i]);
   }
   printf("\n");
   //Min and Max values printing
   printf("Minimum value: %d\n",arr[0]);
   printf("Maximum value: %d\n",arr[n-1]);
}
