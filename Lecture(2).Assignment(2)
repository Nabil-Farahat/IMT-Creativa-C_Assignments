#include <stdio.h>

int main()
{
	//using float because of the division operation
	float a,b;
	// using integer because the switch command only accepts integers
	int OP;
	printf("Enter first number: ");
	scanf("%f",&a);
	
	printf("Enter second number: ");
	scanf("%f",&b);
	printf(" 1 for addition\n 2 for subtraction\n 3 for multiplication\n 4 for division\n");
	printf("Enter the number of wanted operation: ");
	scanf("%d",&OP);
	switch (OP)
	{
		case 1: printf("Addition = %f \n",(a + b));break;
		case 2: printf("Subtraction = %f \n",(a - b));break;	
		case 3: printf("Multiplication = %f \n",(a * b));break;
		case 4: printf("Division = %f \n",(a / b));break;
	}
	return 0;
}
