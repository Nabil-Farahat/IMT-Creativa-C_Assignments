#include <stdio.h>

int main ()
{
	int n ;
	printf("Enter number of elements: ");
	scanf("%d",&n);
	int arr[n];
	
	for (int i = 0; i < n; i++)
	{
		printf("enter the %d element: ",i+1);
		scanf("%d",&arr[i]);
	}

    int evens = 0;
    int odds = 0;

    for (int i = 0; i < n; i++)
    {
        if (arr[i] % 2 == 0)
        {
            evens += arr[i];
        }
        else
        {
            odds += arr[i];
        }
    }

    printf("\nSum of even numbers: %d\n", evens);
    printf("Sum of odd numbers: %d\n", odds);

    return 0;
}
