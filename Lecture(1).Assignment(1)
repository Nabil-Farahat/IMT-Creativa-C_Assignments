#include <stdio.h>

int main()
{
	int max_blocks = 11;
	// Rows go from 1 block up to 11 blocks, skipping by 2 to keep it symmetrical
    for(int i = 1; i <= max_blocks; i+=2)
	{
		// Calculate the spaces needed to place the blocks
		int spaces = (max_blocks - i) / 2 ;
		
		// Print leading spaces
	    for(int j = 0; j < spaces; j++)
	   {
		   printf(" ");
	   }
	   // Print the pyramid blocks
	   for (int star = 0; star < i; star++)
	   {
		   printf("*");
	   }
	   // Move to the next line
	   printf("\n");
	}
}
