#include <stdio.h>


int main ()
{
	//declearing elements
	int x = 2,y = 3,z = 4;
	int *p,*q,*r;
	
	p = &x;
	q = &y;
	r = &z;
	
	printf("before swap:\n");
	printf("x = %d, y = %d, z = %d\n", x, y, z);
    printf("p = %p, q = %p, r = %p\n", p, q, r);
    printf("*p = %d, *q = %d, *r = %d\n", *p, *q, *r);
	// swapping values 
	int *temp = r;
	r = q;
	q = p;
	p = temp;
	
	printf("after swap:\n");
	printf("x = %d, y = %d, z = %d\n", x, y, z);
    printf("p = %p, q = %p, r = %p\n", p, q, r);
    printf("*p = %d, *q = %d, *r = %d\n", *p, *q, *r);
	return 0;
}
