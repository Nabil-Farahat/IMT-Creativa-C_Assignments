#include <stdio.h>

int main() 
{
    int num;

    printf("enter a number: ");
    if (scanf("%d", &num) != 1) {
        printf("invalid input! Please enter an integer.\n");
        return 1;
    }

    printf("\nMultiplication table for %d (from 1 to %d):\n", num, num);

    for (int i = 1; i <= num; i++) {
        printf("%d * %d = %d\n", num, i, num * i);
    }

    return 0;
}
